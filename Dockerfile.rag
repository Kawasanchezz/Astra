# Base fixada por digest (Dependabot a atualiza); o tag legível fica no comentário.
FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_DISABLE_SYMLINKS_WARNING=1

RUN apt-get update && apt-get install -y --only-upgrade zlib1g && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-rag.lock ./
RUN pip install --require-hashes --no-deps -r requirements-rag.lock

COPY servidor servidor
COPY docs docs
COPY prompts prompts

WORKDIR /app/servidor
RUN python -m rag indexar \
    && python -m pip uninstall -y pip

RUN useradd --system --uid 10001 --no-create-home app && chown -R app /app/.cache
USER app

ENV RAG_API_HOST=0.0.0.0 RAG_API_PORT=8000
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"
CMD ["gunicorn", "--workers", "1", "--threads", "4", "--timeout", "60", "--no-control-socket", "--bind", "0.0.0.0:8000", "rag.wsgi:app"]
